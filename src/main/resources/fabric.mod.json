{
	"schemaVersion": 1,
	"id": "cilvelipriv",
	"version": "${version}",
	"name": "Cilveli Priv",
	"description": "Oyunda görünmez olan veya pusan oyuncuları rahatça görmeniz için yapılmış basit bir mod.\nMod menüsünden veya F4 ile açıp kapatabiliyorsun. Yarı saydam veya parlayan şekilde görünmelerini ayarlar kısmından seçebilirsin.",
	"authors": [
		"burakfitnes"
	],
	"contact": {
		"homepage": "https://github.com/burakffir/cilveli-priv",
		"sources": "https://github.com/burakffir/cilveli-priv",
		"issues": "https://github.com/burakffir/cilveli-priv/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"me.batuhan.cilveligorunmez.CilveliGorunmez"
		],
		"modmenu": [
			"me.batuhan.cilveligorunmez.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "cilvelipriv.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}